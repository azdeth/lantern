{
  "name": "Lantern: light novel reader",
  "short_name": "Lantern",
  "description": "Read light novels or have them read aloud, chapter by chapter.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14162a",
  "theme_color": "#14162a",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "book", "accept": [".epub", "application/epub+zip"] }] }
  },
  "file_handlers": [
    { "action": "./", "accept": { "application/epub+zip": [".epub"] } }
  ]
}
